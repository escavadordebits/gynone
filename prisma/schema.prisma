// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // ADMIN or STUDENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  studentProfile Student?
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  packageValue    Float?
  location        String?  // Presencial ou Plataforma
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  anamnesis       Anamnesis?
  workouts        Workout[]
}

model Anamnesis {
  id               String   @id @default(cuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  age              Int?
  weight           Float?
  height           Float?
  bmi              Float?   // IMC
  waistToHipRatio  Float?   // RCQ
  goal             String?  // Objetivo
  seriesStartDate  DateTime?
  estimatedEndDate DateTime?
  modality         String?
  availableTime    String?
  postCycleResult  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Workout {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String   // Ex: Treino A - Peito e Triceps
  description String?
  exercises   String   // Text or JSON with the workout details
  videoUrl    String?
  days        String?  // Ex: "Segunda, Quarta"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // ADMIN or STUDENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  studentProfile Student?
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  packageValue    Float?
  location        String?  // Presencial ou Plataforma
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  anamnesis       Anamnesis?
  workouts        Workout[]
  assessments     PhysicalAssessment[]
}

model Anamnesis {
  id               String   @id @default(cuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  age              Int?
  weight           Float?
  height           Float?
  bmi              Float?   // IMC
  waistToHipRatio  Float?   // RCQ
  goal             String?  // Objetivo
  seriesStartDate  DateTime?
  estimatedEndDate DateTime?
  modality         String?
  availableTime    String?
  postCycleResult  String?
  
  gender           String?  // Masculino ou Feminino
  trainingExperience   String?
  trainingAvailability String?
  hasHealthCondition   Boolean? @default(false)
  healthConditionDetails String?
  chestPain            Boolean? @default(false)
  faintingOrDizziness  Boolean? @default(false)
  shortnessOfBreath    Boolean? @default(false)
  cardiovascularCondition Boolean? @default(false)
  medicalRestriction   Boolean? @default(false)
  postSurgery          Boolean? @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PhysicalAssessment {
  id                    String   @id @default(cuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Teste de Cooper (12 minutos)
  cooperDistance        Float?   // Metros percorridos
  cooperVo2Max          Float?   // mL/kg/min
  cooperClassification  String?  // Muito baixo, Baixo, Regular, Bom, Excelente
  
  // Estimativa de 1RM por repetições
  oneRmExercise         String?  // Nome do exercício (Supino, Agachamento, etc)
  oneRmWeight           Float?   // Carga levantada em kg
  oneRmReps             Int?     // Número de repetições realizadas
  oneRmResultEpley      Float?   // 1RM estimado (Epley)
  oneRmResultBrzycki    Float?   // 1RM estimado (Brzycki)
  
  // Controle de Visibilidade para o Aluno
  isVisibleToStudent    Boolean  @default(true)
  notes                 String?  // Observações adicionais do treinador

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Workout {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String   // Ex: Treino A - Peito e Triceps
  description String?
  exercises   String   // Text or JSON with the workout details
  videoUrl    String?
  days        String?  // Ex: "Segunda, Quarta"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
